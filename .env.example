# MySQL container
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=bms
# Application user (must not be root; the image creates it). Must match DATABASE_URL below.
MYSQL_USER=bms
MYSQL_PASSWORD=bms
# Host port for MySQL. Change it if 3306 is already used on your machine.
MYSQL_HOST_PORT=3306

# Backend
# development | production (production hides reset tokens from API responses)
APP_ENV=development
DATABASE_URL=mysql+pymysql://bms:bms@mysql:3306/bms?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://bms:bms@mysql:3306/bms_test?charset=utf8mb4
# At least 32 random characters (required in production): openssl rand -hex 32
JWT_SECRET=change-me-to-32-or-more-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
TIMEZONE=Asia/Dhaka

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
